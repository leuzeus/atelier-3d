{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "purpose",
    "clips",
    "rigid_parts",
    "source_resources",
    "geometry_tolerance_cm",
    "budgets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "purpose": {
      "enum": [
        "GARMENT_CANDIDATE",
        "TEST_ONLY"
      ]
    },
    "dossier_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "assembly_plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "expected_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "kind",
          "source_pieces"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "TEXTILE",
              "RIGID"
            ]
          },
          "source_pieces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "package_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_receipts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "source_receipts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "rigid_parts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "source_receipt",
          "object_name"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "source_receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "object_name": {
            "type": "string",
            "minLength": 1
          },
          "placement_review_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "source_resources": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_artifact",
          "datablock_name",
          "file_ref"
        ],
        "properties": {
          "source_artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "datablock_name": {
            "type": "string",
            "minLength": 1
          },
          "file_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "geometry_tolerance_cm": {
      "type": "number",
      "minimum": 1e-08,
      "maximum": 0.001
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_seconds",
        "max_samples",
        "max_cache_vertex_frames"
      ],
      "properties": {
        "max_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 7200
        },
        "max_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "max_cache_vertex_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "purpose": {
          "const": "GARMENT_CANDIDATE"
        }
      },
      "required": [
        "dossier_ref",
        "assembly_plan_ref"
      ]
    },
    {
      "properties": {
        "purpose": {
          "const": "TEST_ONLY"
        }
      },
      "required": [
        "expected_inventory"
      ]
    }
  ]
}
