{
  "type":"object","additionalProperties":false,
  "required":["version","source_ref","object_names","frame","resolution","views","max_seconds"],
  "properties":{
    "version":{"const":1},
    "source_ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "object_names":{"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "frame":{"type":"integer","minimum":1,"maximum":100000},
    "resolution":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":128,"maximum":2048}},
    "views":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"enum":["front","side","back","threequarter"]}},
    "max_seconds":{"type":"number","minimum":1,"maximum":3600}
  }
}
