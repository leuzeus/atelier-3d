{
  "type": "object", "additionalProperties": false,
  "required": ["version", "export_profile_ref", "object_names", "clip_ids", "fps", "views", "resolution", "display", "budgets"],
  "properties": {
    "version": {"const": 1},
    "export_profile_ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "object_names": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "clip_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}},
    "fps": {"type": "integer", "minimum": 1, "maximum": 240},
    "views": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["front", "side", "back", "threequarter"]}},
    "resolution": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 64, "maximum": 4096}},
    "display": {"enum": ["NEUTRAL", "MATERIALS"]},
    "budgets": {
      "type": "object", "additionalProperties": false, "required": ["max_render_frames", "max_seconds"],
      "properties": {"max_render_frames": {"type": "integer", "minimum": 2, "maximum": 40000}, "max_seconds": {"type": "number", "minimum": 1, "maximum": 7200}, "max_sample_vertex_frames": {"type": "integer", "minimum": 1, "maximum": 100000000}}
    }
  }
}
