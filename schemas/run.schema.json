{
  "type": "object",
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 100},
    "asset_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["garment", "comfy", "material_bench", "motion", "export"]},
    "inputs": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object",
        "properties": {
