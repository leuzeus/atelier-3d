        "max_seconds": {"type": "number", "minimum": 0.01, "maximum": 3600}
      },
      "required": ["max_attempts", "max_seconds"], "additionalProperties": false
    },
    "units": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100},
          "dependencies": {"type": "array", "uniqueItems": true, "maxItems": 128,
                           "items": {"type": "string", "minLength": 1}},
          "executor": {"enum": ["blender", "comfy"]},
          "operation": {"type": "string", "minLength": 1},
          "code_paths": {"type": "array", "maxItems": 128, "uniqueItems": true,
                         "items": {"type": "string", "minLength": 1}},
          "arguments": {"type": "object"},
          "inputs": {
            "type": "array", "maxItems": 512,
            "items": {
              "type": "object",
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              },
              "required": ["path", "sha256"], "additionalProperties": false
            }
          },
          "budgets": {
            "type": "object",
            "properties": {
              "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
              "max_seconds": {"type": "number", "minimum": 0.01, "maximum": 3600}
            },
            "required": ["max_attempts", "max_seconds"], "additionalProperties": false
          },
          "success_statuses": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
