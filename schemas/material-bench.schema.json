{
  "type": "object",
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["mount", "drape"]},
    "bindings": {
      "type": "object",
      "properties": {"candidate": {"type": "object"}, "source": {"type": "object"}, "body": {"type": "object"},
                     "pose": {"type": "object"}, "recipe": {"type": "object"}},
      "required": ["candidate", "source", "body", "pose", "recipe"], "additionalProperties": false
    },
    "programs": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
                 "items": {"enum": ["cantilever", "sewing", "contact"]}},
    "laboratory": {"type": "object", "properties": {
      "seed_set": {"enum": ["legacy-v1", "supported-v2"]}},
      "required": ["seed_set"], "additionalProperties": false},
    "factor": {"type": "object", "properties": {
      "parameter": {"enum": ["tension_stiffness", "compression_stiffness", "shear_stiffness", "bending_stiffness", "structural_damping", "air_damping"]},
      "values": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true,
                 "items": {"type": "number", "minimum": 0.00001, "maximum": 100}}},
      "required": ["parameter", "values"], "additionalProperties": false},
    "execution": {"type": "object", "properties": {
      "fps": {"type": "integer", "minimum": 1, "maximum": 120},
      "max_frames": {"type": "integer", "minimum": 8, "maximum": 240},
      "max_seconds": {"type": "number", "minimum": 0.01, "maximum": 120},
      "min_frames": {"type": "integer", "minimum": 2, "maximum": 240},
      "window_frames": {"type": "integer", "minimum": 2, "maximum": 120},
      "velocity_tolerance_cm_s": {"type": "number", "minimum": 0, "maximum": 100}},
      "required": ["fps", "max_frames", "max_seconds", "min_frames", "window_frames", "velocity_tolerance_cm_s"],
      "additionalProperties": false}
  },
  "required": ["version", "id", "component_id", "phase", "bindings", "programs", "factor", "execution"],
  "additionalProperties": false
}
