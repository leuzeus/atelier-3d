{
  "type":"object",
  "properties":{
    "version":{"const":1},
    "id":{"type":"string","minLength":1,"maxLength":100},
    "component_id":{"type":"string","minLength":1},
    "purpose":{"enum":["TEST_ONLY","GARMENT_CANDIDATE"]},
    "phase":{"const":"drape"},
    "fit_context":{"type":"object","additionalProperties":false,"required":["compiled_dossier_ref","fit_profile_ref"],"properties":{
      "compiled_dossier_ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
      "fit_profile_ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
    }},
    "body_collision":{"type":"object","properties":{
      "outer_thickness_cm":{"type":"number","minimum":0.001,"maximum":1},
      "inner_thickness_cm":{"type":"number","minimum":0.001,"maximum":1}
    },"required":["outer_thickness_cm","inner_thickness_cm"],"additionalProperties":false},
    "animated_colliders":{"type":"array","maxItems":16,"items":{"type":"object","properties":{
      "id":{"type":"string","minLength":1},
      "source_receipt":{"type":"object","properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["path","sha256"],"additionalProperties":false},
      "artifact":{"type":"object","properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["path","sha256"],"additionalProperties":false},
      "object_name":{"type":"string","minLength":1},"recipe_object":{"type":"string","minLength":1},
      "clip_id":{"type":"string","minLength":1}
    },"required":["id","source_receipt","artifact","object_name","recipe_object","clip_id"],"additionalProperties":false}},
    "bindings":{"type":"object","properties":{
      "candidate":{"type":"object","properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["path","sha256"],"additionalProperties":false},
      "recipe":{"type":"object","properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["path","sha256"],"additionalProperties":false},
      "body_motion_receipt":{"type":"object","properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["path","sha256"],"additionalProperties":false}
    },"required":["candidate","recipe","body_motion_receipt"],"additionalProperties":false},
    "execution":{"type":"object","properties":{
      "max_frames":{"type":"integer","minimum":1,"maximum":300},
      "max_seconds":{"type":"number","minimum":0.01,"maximum":3600},
      "max_step_cm":{"type":"number","minimum":0.00001,"maximum":5},
      "min_substeps":{"type":"integer","minimum":2,"maximum":16},
      "max_subdivisions":{"type":"integer","minimum":2,"maximum":128},
      "max_pairs":{"type":"integer","minimum":1,"maximum":200000}
      ,"max_cache_vertex_frames":{"type":"integer","minimum":1,"maximum":12000000}
    },"required":["max_frames","max_seconds","max_step_cm","min_substeps","max_subdivisions","max_pairs","max_cache_vertex_frames"],"additionalProperties":false},
    "terminal_relax":{"type":"object","properties":{
      "max_frames":{"type":"integer","minimum":3,"maximum":120},
      "min_frames":{"type":"integer","minimum":2,"maximum":120},
      "window_frames":{"type":"integer","minimum":2,"maximum":119},
      "velocity_tolerance_cm_s":{"type":"number","minimum":0,"maximum":100}
    },"required":["max_frames","min_frames","window_frames","velocity_tolerance_cm_s"],"additionalProperties":false}
  },
  "required":["version","id","component_id","purpose","phase","bindings","execution"],
  "additionalProperties":false
}
