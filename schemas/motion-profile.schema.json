  "required": ["version", "clip_id", "body_geometry_sha256", "rig_specification_sha256", "source_ref", "fps", "frame_start", "frame_end", "sample_interval_frames", "intermediate_substeps", "max_increment_cm", "interpolation", "axis_convention", "tracks"],
