    "intermediate_substeps": {"type": "integer", "minimum": 1, "maximum": 16},
    "max_increment_cm": {"type": "number", "minimum": 0.00001, "maximum": 100},
    "interpolation": {"const": "LINEAR"},
    "axis_convention": {"const": "DERIVED_BONE_LOCAL_XYZ_REQUIRES_REVIEW"},
