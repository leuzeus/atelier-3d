{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "destination",
    "source_ref",
    "object_names",
    "dependency_names",
    "action_names",
    "embedded_image_names",
    "unit_scale_m",
    "fps",
    "reference_frame",
    "clips",
    "resources",
    "motion_receipts",
    "pack_resources",
    "geometry_tolerance_cm",
    "budgets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "destination": {
      "const": "blender_animation"
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "object_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependency_names": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "action_names": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "embedded_image_names": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unit_scale_m": {
      "type": "number",
      "minimum": 1e-06,
      "maximum": 1000
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "reference_frame": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "clips": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object_name",
          "action_name",
          "slot_identifier",
          "frame_start",
          "frame_end",
          "sample_step"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "object_name": {
            "type": "string",
            "minLength": 1
          },
          "action_name": {
            "type": "string",
            "minLength": 1
          },
          "slot_identifier": {
            "type": "string",
            "minLength": 1
          },
          "frame_start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "frame_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "sample_step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "animation_target": {
            "enum": [
              "OBJECT",
              "SHAPE_KEYS"
            ]
          },
          "tracks": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "object_name",
                "action_name",
                "slot_identifier",
                "animation_target"
              ],
              "properties": {
                "object_name": {
                  "type": "string",
                  "minLength": 1
                },
                "action_name": {
                  "type": "string",
                  "minLength": 1
                },
                "slot_identifier": {
                  "type": "string",
                  "minLength": 1
                },
                "animation_target": {
                  "enum": [
                    "OBJECT",
                    "SHAPE_KEYS"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "datablock_name",
          "file_ref"
        ],
        "properties": {
          "kind": {
            "const": "IMAGE"
          },
          "datablock_name": {
            "type": "string",
            "minLength": 1
          },
          "file_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "motion_receipts": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "pack_resources": {
      "const": true
    },
    "geometry_tolerance_cm": {
      "type": "number",
      "minimum": 1e-08,
      "maximum": 0.01
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_seconds",
        "max_samples"
      ],
      "properties": {
        "max_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 7200
        },
        "max_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        }
      }
    }
  }
}
