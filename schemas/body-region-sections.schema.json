{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate source-bound limb skin sections and conservative whole-hand projections",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "purpose": {
      "enum": [
        "TEST_ONLY",
        "MEASUREMENT_PROPOSAL"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_cache_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "geometry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pose_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "face_sets_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "triangles_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "profile_sha256",
        "profile_cache_key",
        "geometry_sha256",
        "source_sha256",
        "pose_sha256",
        "face_sets_sha256",
        "triangles_sha256"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "properties": {
        "profile_ref": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "geometry_ref": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "triangles_ref": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "profile_ref",
        "geometry_ref",
        "triangles_ref"
      ],
      "additionalProperties": false
    },
    "numerical_tolerance_cm": {
      "type": "number",
      "minimum": 1e-8,
      "maximum": 0.0001
    },
    "regions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "enum": [
              "left",
              "right"
            ]
          },
          "domain": {
            "enum": [
              "SHOULDER_TO_ELBOW_ONLY",
              "WRIST_TO_ELBOW_ONLY"
            ]
          },
          "axis_start_landmark": {
            "type": "string",
            "minLength": 1
          },
          "axis_end_landmark": {
            "type": "string",
            "minLength": 1
          },
          "plane_reference_axis": {
            "enum": [
              "right",
              "forward",
              "up"
            ]
          },
          "fraction_domain": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "fractions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "face_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200000,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "source_ref": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "side",
          "domain",
          "axis_start_landmark",
          "axis_end_landmark",
          "plane_reference_axis",
          "fraction_domain",
          "fractions",
          "face_ids",
          "source_ref"
        ],
        "additionalProperties": false
      }
    },
    "hand_envelopes": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "enum": [
              "left",
              "right"
            ]
          },
          "plane_reference_axis": {
            "enum": [
              "right",
              "forward",
              "up"
            ]
          },
          "source_ref": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "side",
          "plane_reference_axis",
          "source_ref"
        ],
        "additionalProperties": false
      }
    },
    "hand_source": {
      "type": "object",
      "properties": {
        "adapter_ref": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "source_geometry_ref": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "adapter_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_geometry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "adapter_ref",
        "source_geometry_ref",
        "adapter_sha256",
        "source_geometry_sha256"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_sections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_triangle_evaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "max_projection_vertices": {
          "type": "integer",
          "minimum": 3,
          "maximum": 1000000
        }
      },
      "required": [
        "max_sections",
        "max_triangle_evaluations",
        "max_projection_vertices"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "purpose",
    "identity",
    "bindings",
    "numerical_tolerance_cm",
    "regions",
    "budgets"
  ],
  "additionalProperties": false
}
