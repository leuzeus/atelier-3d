{
  "type": "object", "additionalProperties": false,
  "required": ["version", "bindings", "section_parameters", "source_edge_spacing_cm", "budgets"],
  "properties": {
    "version": {"const": 1},
    "bindings": {
      "type": "object", "additionalProperties": false, "required": ["templates_ref", "body_geometry_ref", "body_triangles_ref"],
      "properties": {
        "templates_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
        "body_geometry_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
        "body_triangles_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
      }
    },
    "section_parameters": {"type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "source_edge_spacing_cm": {"type": "number", "minimum": 0.001, "maximum": 2},
    "mount_order": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mount_order_source_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "method_configurations": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["method_id", "mode", "source_ref", "source_link_states"],
        "properties": {
          "method_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "mode": {"enum": ["RAISED_OPEN_HOOD", "LOWERED_OPEN_HOOD", "OPEN_SHOULDER_YOKE"]},
          "source_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
          "source_link_states": {"type": "array", "minItems": 1, "maxItems": 128,
            "items": {"type": "object", "additionalProperties": false, "required": ["source_link_id", "state"],
              "properties": {"source_link_id": {"type": "string", "minLength": 1}, "state": {"const": "OPEN"}}}}
        }
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false, "required": ["max_boundary_edges", "max_body_triangles", "max_methods", "max_sections", "max_candidate_orders", "max_path_points"],
      "properties": {
        "max_boundary_edges": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_body_triangles": {"type": "integer", "minimum": 4, "maximum": 1000000},
        "max_methods": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_sections": {"type": "integer", "minimum": 2, "maximum": 1024},
        "max_candidate_orders": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_path_points": {"type": "integer", "minimum": 2, "maximum": 10000}
      }
    }
  }
}
