{
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "REFINING",
        "BEHAVIOR_AUTHORING"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "SKIP",
          "NOT_EXECUTED",
          "INCONCLUSIVE"
        ]
      }
    },
    "check_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "asset_id",
    "stage",
    "artifacts",
    "checks",
    "check_evidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
