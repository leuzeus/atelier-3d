{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atelier 3D material",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "base_color": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    },
    "roughness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "metallic": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "id",
    "name",
    "base_color",
    "roughness",
    "metallic"
  ],
  "additionalProperties": false
}
