{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned immutable source/body/skin guide reconstruction policy",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "generator": {
      "const": "GARMENT_VOLUME_FRAMES_V1"
    },
    "compiled_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dossier_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "specification_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "body_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "geometry_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "generator_code_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "package_source_ref": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "upper_blend": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "surface_sections": {
            "type": "boolean"
          },
          "skin_section_heights_cm": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 400
            },
            "uniqueItems": true,
            "maxItems": 32
          },
          "skin_sections_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "package_source_ref",
          "upper_blend",
          "surface_sections",
          "skin_section_heights_cm"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "generator",
    "compiled_sha256",
    "dossier_ref",
    "specification_ref",
    "body_ref",
    "geometry_ref",
    "generator_code_sha256",
    "components"
  ],
  "additionalProperties": false
}
