{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atelier 3D provenance",
  "type": "object",
  "properties": {
    "component_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "component_id",
    "source_files",
    "workflow_id",
    "workflow_sha256",
    "seed",
    "job_id",
    "outputs",
    "decisions"
  ],
  "additionalProperties": false
}
