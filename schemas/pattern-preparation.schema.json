{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native source-pattern preparation; no Cloth qualification",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "regular_mesh": {
      "type": "object",
      "properties": {
        "spacing_cm": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 10
        },
        "min_spacing_cm": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 10
        },
        "refinement_distance_cm": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "max_vertices": {
          "type": "integer",
          "minimum": 20,
          "maximum": 50000
        },
        "target_min_angle_degrees": {
          "type": "number",
          "minimum": 3,
          "maximum": 30,
          "default": 15
        }
      },
      "required": [
        "spacing_cm",
        "min_spacing_cm",
        "refinement_distance_cm",
        "max_vertices"
      ],
      "additionalProperties": false
    },
    "meshing_profile": {
      "type": "object",
      "properties": {
        "version": {"const": 1},
        "mode": {"const": "SYNCHRONIZED_GRADED_V1"},
        "piece_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "budgets": {
          "type": "object",
          "properties": {
            "max_seconds": {"type": "number", "minimum": 0.001, "maximum": 600},
            "max_capture_nodes": {"type": "integer", "minimum": 1, "maximum": 500000},
            "max_capture_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
            "max_output_nodes": {"type": "integer", "minimum": 1, "maximum": 500000},
            "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
            "max_work_steps": {"type": "integer", "minimum": 1, "maximum": 1000000000},
            "max_sampling_calls": {"type": "integer", "minimum": 1, "maximum": 64},
            "max_sampling_point_slots": {"type": "integer", "minimum": 1, "maximum": 1920000},
            "max_fraction_requests": {"type": "integer", "minimum": 1, "maximum": 4000}
          },
          "required": ["max_seconds", "max_capture_nodes", "max_capture_bytes", "max_output_nodes", "max_output_bytes", "max_work_steps", "max_sampling_calls", "max_sampling_point_slots", "max_fraction_requests"],
          "additionalProperties": false
        }
      },
      "required": ["version", "mode", "piece_ids", "budgets"],
      "additionalProperties": false,
      "description": "Explicit sourced boundary gradation and permanent-birth native meshing, under one caller-local envelope. Does not grant readiness, simulation or human acceptance."
    },
    "anchor_reserve_correction": {
      "type": "object",
      "properties": {
        "version": {"const": 1},
        "mode": {"const": "PERMANENT_COMPONENT_BODY_AXIS_TRANSLATION_V1"},
        "body_ref": {"type": "object", "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "required": ["path", "sha256"], "additionalProperties": false},
        "direction": {"const": "BODY_FRAME_UP"},
        "reserve_source": {"const": "PLAN_COLLISION_CLEARANCE"},
        "budgets": {"type": "object", "properties": {
          "max_displacement_cm": {"type": "number", "minimum": 0.001, "maximum": 8},
          "max_step_cm": {"type": "number", "minimum": 0.001, "maximum": 0.5},
          "max_iterations": {"type": "integer", "minimum": 1, "maximum": 1000},
          "max_seconds": {"type": "number", "minimum": 0.001, "maximum": 60}
        }, "required": ["max_displacement_cm", "max_step_cm", "max_iterations", "max_seconds"], "additionalProperties": false}
      },
      "required": ["version", "mode", "body_ref", "direction", "reserve_source", "budgets"],
      "additionalProperties": false,
      "description": "Opt-in rigid proposal for full permanent components before fixing stops; native closed body identity and unchanged rest quality are required. No fitting or source-pattern acceptance."
    },
    "assembly_plan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "construction_dossier": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "mass_policy": {
      "enum": [
        "native_uniform_vertex",
        "require_exact_surface_density"
      ],
      "default": "native_uniform_vertex"
    },
    "migration": {
      "type": "object",
      "properties": {
        "retire_legacy_preparations": {
          "const": true
        }
      },
      "required": [
        "retire_legacy_preparations"
      ],
      "additionalProperties": false
    },
    "material_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "pieces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "areal_density_kg_m2": {
            "type": "number",
            "minimum": 0.0001,
            "maximum": 10
          },
          "category": {
            "enum": [
              "main",
              "lining",
              "reinforcement",
              "accessory"
            ]
          },
          "cloth_profile": {
            "type": "string",
            "minLength": 1,
            "description": "Existing per-phase regional profile ID, or phase_base for unchanged scalar phase settings."
          },
          "visual_material_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Visual material reference only; it does not change Cloth parameters."
          }
        },
        "required": [
          "id",
          "source_ref",
          "pieces",
          "areal_density_kg_m2"
        ],
        "additionalProperties": false
      }
    },
    "source_preform_budget": {
      "type": "object",
      "description": "Recomputed flat source seed to declared guide staging bound. Does not change assembly, Cloth, metric, contact or correction limits.",
      "properties": {
        "version": {"const": 1},
        "basis": {"const": "SOURCE_FLAT_SEED_TO_DECLARED_GUIDE_BEFORE_EXECUTION"},
        "source_garment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "guides_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "placements_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "max_displacement_cm": {"type": "number", "minimum": 0.01, "maximum": 10000},
        "physical_budgets_changed": {"const": false},
        "panels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "bound_cm": {"type": "number", "minimum": 0.01, "maximum": 10000},
              "method": {"enum": ["AFFINE_SOURCE_BOUNDARY_AND_CONVEX_ARC_SECTION_ENVELOPE", "AFFINE_SOURCE_BOUNDARY_AND_CONVEX_BARYCENTRIC_TARGET_ENVELOPE", "CORRESPONDING_AFFINE_SOURCE_BOUNDARY_EXTREMA"]},
              "guide_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "source_contour_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "native_float32_guard_cm": {"type": "number", "minimum": 0.0001, "maximum": 1},
              "budget_rounding_cm": {"const": 0.01},
              "gate_thresholds_changed": {"const": false}
            },
            "required": ["bound_cm", "method", "guide_sha256", "source_contour_sha256", "native_float32_guard_cm", "budget_rounding_cm", "gate_thresholds_changed"],
            "additionalProperties": false
          }
        }
      },
      "required": ["version", "basis", "source_garment_sha256", "guides_sha256", "placements_sha256", "max_displacement_cm", "panels", "physical_budgets_changed"],
      "additionalProperties": false
    },
    "metric_recovery": {
      "type": "object",
      "properties": {
        "version": {"const": 1},
        "piece_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "protected_edges": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "properties": {"piece": {"type": "string", "minLength": 1}, "edge": {"type": "string", "minLength": 1}},
            "required": ["piece", "edge"], "additionalProperties": false
          }
        },
        "budgets": {
          "type": "object",
          "properties": {
            "max_iterations": {"type": "integer", "minimum": 1, "maximum": 1000},
            "max_seconds": {"type": "number", "minimum": 0.001, "maximum": 3600},
            "max_displacement_cm": {"type": "number", "minimum": 1e-9, "maximum": 1000},
            "max_step_cm": {"type": "number", "minimum": 1e-9, "maximum": 100},
            "cg_iterations": {"type": "integer", "minimum": 1, "maximum": 1000},
            "cg_tolerance": {"type": "number", "minimum": 1e-12, "maximum": 0.1},
            "stagnation_iterations": {"type": "integer", "minimum": 1, "maximum": 100}
          },
          "required": ["max_iterations", "max_seconds", "max_displacement_cm", "max_step_cm", "cg_iterations", "cg_tolerance", "stagnation_iterations"],
          "additionalProperties": false
        },
        "strain_weight": {"type": "number", "minimum": 1e-9, "maximum": 1000000},
        "seam_ids": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}},
        "anchor_scope": {"enum": ["per_piece", "permanent_component"]},
        "max_initial_seam_gap_cm": {"type": "number", "minimum": 0, "maximum": 2}
      },
      "required": ["version", "piece_ids", "protected_edges", "budgets", "strain_weight"],
      "anyOf": [
        {"properties": {"seam_ids": false, "max_initial_seam_gap_cm": false,
                        "anchor_scope": {"enum": ["per_piece"]}}},
        {"required": ["seam_ids", "max_initial_seam_gap_cm"]}
      ],
      "additionalProperties": false,
      "description": "Opt-in recovery of source UV metric before contact search. Optional exact permanent seam IDs share quotient unknowns; their declared initial alignment bound is not a final seam acceptance threshold. Displacement is shared with contact correction from the original guide, and all downstream gates remain required."
    },
    "placement_correction": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kernels": {
          "type": "array",
          "items": {
            "enum": [
              "rigid",
              "relaxation"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "budgets": {
          "type": "object",
          "properties": {
            "max_iterations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_seconds": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 3600
            },
            "max_proposals_per_iteration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_displacement_cm": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "max_step_cm": {
              "type": "number",
              "minimum": 1e-06,
              "maximum": 100
            },
            "stagnation_iterations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "min_improvement": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            "target_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "max_iterations",
            "max_seconds",
            "max_proposals_per_iteration",
            "max_displacement_cm",
            "max_step_cm",
            "stagnation_iterations",
            "min_improvement",
            "target_score"
          ],
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "properties": {
            "min_angle_degrees": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "min_edge_cm": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "min_stretch": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 1
            },
            "max_stretch": {
              "type": "number",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "min_angle_degrees",
            "min_edge_cm",
            "min_stretch",
            "max_stretch"
          ],
          "additionalProperties": false
        },
        "protected_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "kernels",
        "budgets",
        "quality"
      ],
      "additionalProperties": false,
      "description": "Explicit bounded native source-preserving contact correction before Cloth; final readiness still uses unchanged preparation gates."
    }
  },
  "required": [
    "version",
    "component_id",
    "source_ref",
    "regular_mesh"
  ],
  "additionalProperties": false
}
