{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source garment classification and explicit ease intent",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "dossier_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "body_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "component_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "classification": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "coat",
            "jacket",
            "dress",
            "shirt",
            "trousers",
            "skirt",
            "accessory",
            "other",
            "unspecified"
          ]
        },
        "silhouette_intent": {
          "enum": [
            "close",
            "regular",
            "relaxed",
            "oversized",
            "unspecified"
          ]
        },
        "wearing_configuration": {
          "enum": [
            "closed",
            "open_front",
            "wrap",
            "unspecified"
          ]
        },
        "layer_role": {
          "enum": [
            "inner",
            "outer",
            "single",
            "ensemble",
            "unspecified"
          ]
        }
      },
      "required": [
        "category",
        "silhouette_intent",
        "wearing_configuration",
        "layer_role"
      ],
      "additionalProperties": false
    },
    "open_front": {
      "type": "object",
      "properties": {
        "minimum_overlap_cm": {
          "type": "number",
          "minimum": 0
        },
        "source_ref": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "minimum_overlap_cm",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "body_landmark": {
            "type": "string",
            "minLength": 1
          },
          "homology_source_ref": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "path_kind": {
            "enum": [
              "closed_girth",
              "open_material_span"
            ]
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "piece": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "object",
                  "properties": {
                    "edge": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "edge",
                    "fraction"
                  ],
                  "additionalProperties": false
                },
                "to": {
                  "type": "object",
                  "properties": {
                    "edge": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fraction": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "edge",
                    "fraction"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "piece",
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "joins": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "engaged_links": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "ease": {
            "type": "object",
            "properties": {
              "minimum_cm": {
                "type": "number"
              },
              "target_cm": {
                "type": "number"
              },
              "maximum_cm": {
                "type": "number"
              },
              "movement_cm": {
                "type": "number",
                "minimum": 0
              },
              "underlayers_cm": {
                "type": "number",
                "minimum": 0
              },
              "style_cm": {
                "type": "number"
              },
              "source_ref": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "minimum_cm",
              "target_cm",
              "maximum_cm",
              "movement_cm",
              "underlayers_cm",
              "style_cm",
              "source_ref"
            ],
            "additionalProperties": false
          },
          "takeup": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "amount_cm": {
                  "type": "number",
                  "minimum": 0
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ref": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "amount_cm",
                "reason",
                "source_ref"
              ],
              "additionalProperties": false
            }
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "body_landmark",
          "homology_source_ref",
          "path_kind",
          "segments",
          "joins",
          "engaged_links",
          "ease",
          "takeup",
          "component_id",
          "layer"
        ],
        "additionalProperties": false
      }
    },
    "required_measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "minLength": 1
          },
          "body_landmark": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "component_id",
          "layer",
          "body_landmark"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "source_ref",
    "dossier_ref",
    "body_ref",
    "component_ids",
    "classification",
    "measurements",
    "required_measurements"
  ],
  "additionalProperties": false
}
