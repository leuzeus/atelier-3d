{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed source-component textile group program",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "purpose": {"enum": ["TEST_ONLY", "GARMENT_CANDIDATE"]},
    "fit_context": {
      "type": "object",
      "properties": {
        "compiled_dossier_ref": {
          "type": "object", "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "required": ["path", "sha256"], "additionalProperties": false
        },
        "fit_profiles_refs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "object", "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
            "required": ["path", "sha256"], "additionalProperties": false}
        }
      },
      "required": ["compiled_dossier_ref", "fit_profiles_refs"], "additionalProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "program_path": {
      "type": "string",
      "minLength": 1
    },
    "assembly_plan_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "package_ref": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "derived_mesh_ref": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "recipe_ref": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "plan_ref": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "component_id",
          "package_ref",
          "derived_mesh_ref",
          "recipe_ref",
          "plan_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "experimental_coupled_multilayer": {
      "type": "boolean"
    },
    "run_budgets": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_seconds": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 3600
        }
      },
      "required": [
        "max_attempts",
        "max_seconds"
      ],
      "additionalProperties": false
    },
    "frozen_collider_policy": {
      "type": "object",
      "properties": {
        "outer_thickness_cm": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "inner_thickness_cm": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "tolerance_cm": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 5
        },
        "outward_normal_sign": {
          "enum": [
            -1,
            1
          ]
        }
      },
      "required": [
        "outer_thickness_cm",
        "inner_thickness_cm",
        "tolerance_cm",
        "outward_normal_sign"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "purpose",
    "id",
    "asset_id",
    "program_path",
    "assembly_plan_ref",
    "components",
    "run_budgets"
  ],
  "additionalProperties": false
}
