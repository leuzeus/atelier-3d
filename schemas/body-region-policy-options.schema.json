{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit generic body region measurement policy options",
  "type": "object",
  "properties": {
    "purpose": {"enum": ["TEST_ONLY", "MEASUREMENT_PROPOSAL"]},
    "regions": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["upper", "forearm"]}},
    "sides": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["left", "right"]}},
    "include_hand_envelopes": {"type": "boolean"},
    "fractions": {"type": "array", "minItems": 2, "maxItems": 1000, "uniqueItems": true, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "fraction_domain": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "plane_reference_axis": {"enum": ["right", "forward", "up"]},
    "numerical_tolerance_cm": {"type": "number", "minimum": 1e-9, "maximum": 0.01},
    "budgets": {
      "type": "object",
      "properties": {
        "max_sections": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_triangle_evaluations": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "max_projection_vertices": {"type": "integer", "minimum": 3, "maximum": 1000000}
      },
      "required": ["max_sections", "max_triangle_evaluations", "max_projection_vertices"],
      "additionalProperties": false
    }
  },
  "required": ["purpose", "regions", "sides", "include_hand_envelopes", "fractions", "fraction_domain", "plane_reference_axis", "numerical_tolerance_cm", "budgets"],
  "additionalProperties": false
}
