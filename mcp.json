{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "studio": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-B",
        "${PLUGIN_ROOT}/servers/studio/main.py"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
